{
  "$schema": "./schema/piphi-manifest.schema.json",
  "manifest_version": "1.0",
  "id": "piphi-network-kia-hyundai-connect",
  "name": "Kia, Hyundai & Genesis Connect",
  "version": "0.1.0",
  "description": "Monitor and control supported connected vehicles through regional owner services.",
  "metadata": {
    "generator": "piphi-network-create",
    "scaffold_version": "0.3.0",
    "preset": "cloud-polling-api",
    "domain": "cloud-api",
    "preset_summary": "Cloud API starter with vendor endpoint and token-oriented configuration."
  },
  "maintainer": {
    "name": "PiPhi Network",
    "website": "https://piphi.io"
  },
  "license": "Apache-2.0",
  "image": "docker.io/piphinetwork/piphi-network-kia-hyundai-connect:0.1.0",
  "platforms": [
    "linux"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "container": {
        "image": "docker.io/piphinetwork/piphi-network-kia-hyundai-connect:0.1.0",
        "ports": [
          {
            "container": 4217,
            "host": 4217
          }
        ],
        "environment": {
          "LOG_LEVEL": "info"
        },
        "restart_policy": {
          "name": "unless-stopped",
          "maximum_retry_count": 0
        }
      },
      "discovery": {
        "method": "passive"
      }
    }
  },
  "api": {
    "required": [
      "health",
      "entities",
      "command",
      "config",
      "ui_config"
    ],
    "endpoints": {
      "health": "/health",
      "diagnostics": "/diagnostics",
      "discover": "/discover",
      "entities": "/entities",
      "state": "/state",
      "config": "/config",
      "config_sync": "/config/sync",
      "deconfigure": "/deconfigure",
      "ui_config": "/ui-config",
      "events": "/events",
      "command": "/command"
    }
  },
  "config": {
    "source": "endpoint",
    "endpoint": "/ui-config",
    "required": true,
    "editable_fields": [
      "host",
      "alias",
      "base_url",
      "api_key",
      "poll_interval_seconds"
    ],
    "runtime_fields": [
      "id",
      "config_id",
      "container_id",
      "device_id"
    ],
    "identity_fields": [
      "host"
    ]
  },
  "identity": {
    "fields": [
      "host"
    ]
  },
  "capabilities": {
    "connected": {
      "kind": "sensor",
      "unit": "bool"
    },
    "refresh": {
      "kind": "action"
    }
  },
  "commands": {
    "refresh": {
      "description": "Refresh the device state.",
      "timeout_ms": 5000
    }
  },
  "entities": [
    {
      "id": "demo-device",
      "name": "Demo Device",
      "device_id": "demo-device",
      "entity_type": "vehicle",
      "capabilities": [
        "connected",
        "refresh"
      ],
      "available_commands": [
        {
          "id": "refresh",
          "label": "Refresh",
          "kind": "action"
        }
      ],
      "dashboard": {
        "allowed_widgets": [
          "tile",
          "stat",
          "button"
        ],
        "default_widget": "tile"
      }
    }
  ],
  "marketplace": {
    "metadata_version": 2,
    "display_name": "Kia, Hyundai & Genesis Connect",
    "summary": "Monitor and control supported connected vehicles through regional owner services.",
    "category": "mobility",
    "regions": [
      "EU",
      "NA",
      "APAC"
    ],
    "languages": [
      "en"
    ],
    "publisher": {
      "name": "PiPhi Network",
      "website_url": "https://piphi.io",
      "support_url": "https://github.com/PiPhi-io/piphi-network-kia-hyundai-connect/issues",
      "security_contact": "support@piphi.io"
    },
    "access": [
      {
        "id": "credentials",
        "label": "Account or device credentials",
        "reason": "Authenticates only to the configured vendor account, service, or local device and keeps credentials out of state and diagnostics.",
        "required": true
      }
    ],
    "compatibility": [
      {
        "brand": "Kia, Hyundai, and Genesis",
        "model": "Vehicles supported by configured regional connected-services accounts"
      }
    ],
    "documentation_url": "https://github.com/PiPhi-io/piphi-network-kia-hyundai-connect",
    "support_url": "https://github.com/PiPhi-io/piphi-network-kia-hyundai-connect/issues",
    "changelog_url": "https://github.com/PiPhi-io/piphi-network-kia-hyundai-connect/releases",
    "quality_tier": "unrated",
    "governance": {
      "schema_version": 1,
      "publication_status": "draft",
      "rollout_percent": 0,
      "lifecycle_status": "active",
      "qualification": {
        "status": "unverified"
      }
    },
    "device_types": [
      "vehicle",
      "electric vehicle",
      "plug-in hybrid"
    ],
    "protocols": [
      "Kia Connect",
      "Hyundai Bluelink",
      "Genesis Connected Services",
      "HTTPS"
    ],
    "discovery_methods": [
      "account and vehicle discovery"
    ],
    "connectivity": "cloud",
    "offline_support": "none",
    "privacy_url": "https://github.com/PiPhi-io/piphi-network-kia-hyundai-connect/blob/main/docs/privacy.md"
  }
}
